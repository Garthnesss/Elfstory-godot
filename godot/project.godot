; Engine configuration file.
; Generated for ElfStory Reborn (Godot 4.7.2 + Rust)

config_version=5

[application]

config/icon="res://assets/icon/elfstory_icon.png"

run/main_scene="res://Main.tscn"

config/name="ElfStory Reborn"
config/features=PackedStringArray("4.7", "Forward Plus")

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unassigned_variable=2
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unused_signal=1
gdscript/warnings/missing_tool=1
